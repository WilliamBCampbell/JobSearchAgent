# Copy to .env.local, edit, and source with `set -a; . ./.env.local; set +a`.
# The application does not automatically load dotenv files.
JSA_WORKSPACE="$HOME/job_search"
JSA_JOBSPY="$HOME/JobSpy"
JSA_STATE="$HOME/.local/share/job-search-agent"
JSA_ORIGIN=http://127.0.0.1:8765
JSA_HEADLESS=0
JSA_LIVE_SEARCH=0
# Optional discovery override after scripts/install_jobspy_mcp.py --enable.
# JSA_JOBSPY_BACKEND=official_mcp
# JSA_JOBSPY_MCP_PYTHON="$JSA_STATE/integrations/mcp-jobspy-1.4.0/bin/python"
# JSA_JOBSPY_BACKEND=legacy restores the previous live-search worker.
# Optional: JSA_NO_AI_SLOP_SKILL="$HOME/.agents/skills/no-ai-slop/SKILL.md"
# Bootstrap stores generated database credentials in JSA_STATE/database-url.
# JSA_DATABASE_URL can override that private file. Never put a real URL here.
# Submission runs externally through the exported Codex prompt.
# Legacy JSA_LIVE_APPLICATIONS values cannot enable in-app sending.
# Tracker writes are disabled by default and use a separate reviewed preview.
# JSA_LIVE_TRACKER_WRITES=0
# Optional user profile ID for CLI and external MCP operations. Keep JSA_STATE at
# the installation root. The API serves all profiles; the worker polls them all.
JSA_PROFILE=default
